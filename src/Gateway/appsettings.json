{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "inventory-restock": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "inventory",
        "Match": { "Path": "/api/inventory/{itemId}/stock", "Methods": [ "PUT" ] }
      },
      "inventory": {
        "ClusterId": "inventory",
        "Order": 100,
        "RateLimiterPolicy": "inventory",
        "Match": { "Path": "/api/inventory/{**rest}", "Methods": [ "GET" ] }
      },
      "monolith": {
        "ClusterId": "monolith",
        "Order": 1000,
        "Match": { "Path": "{**catch-all}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "inventory": {
        "Destinations": {
          "inventory1": { "Address": "http://localhost:5301/" }
        }
      },
      "monolith": {
        "Destinations": {
          "web": { "Address": "http://localhost:5106/" }
        }
      }
    }
  }
}
